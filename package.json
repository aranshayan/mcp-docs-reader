{
  "name": "@aranshayan/mcp-docs-reader",
  "version": "0.1.1",
  "description": "MCP server that reads PDF, Word (.docx), Excel (.xlsx) and CSV files as LLM-friendly text, Markdown and tables, restricted to folders you allow.",
  "mcpName": "io.github.aranshayan/mcp-docs-reader",
  "type": "module",
  "bin": {
    "mcp-docs-reader": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "pdf",
    "docx",
    "xlsx",
    "csv",
    "documents",
    "claude"
  ],
  "author": "aranshayan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aranshayan/mcp-docs-reader.git"
  },
  "homepage": "https://github.com/aranshayan/mcp-docs-reader#readme",
  "bugs": {
    "url": "https://github.com/aranshayan/mcp-docs-reader/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "jszip": "^3.10.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
